# Supabase (public — safe for browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — SERVER ONLY, never exposed to the browser.
# Used only in app/api/admin/* route handlers for privileged actions
# (creating Agent/Admin accounts). Do not prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Assistant — server-side only, used in app/api/assistant/route.ts
# Get a free key at https://aistudio.google.com/apikey (no card required)
GEMINI_API_KEY=your-gemini-api-key
